generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id           String             @id @default(cuid())
  sessionId    String             @unique
  model        String
  systemPrompt String?            @db.Text
  status       String             @default("active")
  taskTitle    String?
  taskMetadata Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  messages   Message[]
  evaluation Evaluation?

  @@index([createdAt])
  @@index([status])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  sequenceNumber Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequenceNumber])
}

model Evaluation {
  id                      String @id @default(cuid())
  conversationId          String @unique
  totalScore              Float
  conceptArticulation     Float
  logicCoherence          Float
  misconceptionCorrection Float
  cognitiveResilience     Float
  justifications          Json
  rawResponse             String? @db.Text
  evaluatorModel          String?
  createdAt               DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   ClassMember[]
}

model Class {
  id          String   @id @default(cuid())
  name        String
  gradeLevel  String
  subject     String   @default("Math")
  inviteCode  String   @unique
  teacherId   String
  createdAt   DateTime @default(now())
  members     ClassMember[]
}

model ClassMember {
  id      String @id @default(cuid())
  classId String
  userId  String
  role    String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([classId, userId])
  @@index([classId])
  @@index([userId])
}

model Assignment {
  id            String    @id @default(cuid())
  classId       String
  studentId     String
  taskId        String
  taskTitle     String
  status        String    @default("assigned")
  dueDate       DateTime?
  notes         String?
  sessionId     String?
  completedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([studentId])
  @@index([classId])
}

// A teacher-deployed live session. The `code` (e.g. "K7P-2QM") is the ephemeral
// invite a student types on the join screen; it resolves to a pre-authored task.
model LiveSession {
  id         String        @id @default(cuid())
  code       String        @unique
  taskId     String
  title      String?
  teacherId  String
  status     String        @default("live") // draft | live | closed
  createdAt  DateTime      @default(now())
  deployedAt DateTime?
  participants Participant[]
  @@index([status])
}

// An anonymous student who joined a live session by code. Backs a short-lived
// guest JWT (`guestUserId`); no account, no password.
model Participant {
  id          String      @id @default(cuid())
  sessionId   String
  displayName String
  guestUserId String
  status      String      @default("in_progress") // in_progress | completed
  joinedAt    DateTime    @default(now())
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
}

// --- Content tables (task bank + collections) ---
// These live in the production DB but predated this schema file; introspected via
// `prisma db pull` and added here so `prisma db push` treats them as in-sync
// rather than proposing to drop them. The running app reads the task bank from
// src/data/tasks.json, not these tables.
model Collection {
  id          String           @id
  slug        String           @unique
  title       String
  description String?
  grade       String?
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  tasks       CollectionTask[]

  @@index([grade])
}

model CollectionTask {
  collectionId String
  taskId       String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([collectionId, taskId])
}

model Task {
  id                  String           @id
  slug                String           @unique
  title               String
  grade               String
  domain              String
  ccssCode            String
  cluster             String?
  standardStatement   String?
  studentPrompt       String?
  misconceptions      Json?
  patternRecognition  String?
  generalization      String?
  inferencePrediction String?
  mappingData         Json?
  teachingPrompt      String?
  targetConcepts      Json?
  aiIntro             String?
  aiIntroEs           String?
  sourceFile          String?
  published           Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  collections         CollectionTask[]

  @@index([ccssCode])
  @@index([domain])
  @@index([grade])
}
